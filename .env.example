# Names only, never real values. Set real values in Vercel → Project → Settings → Environment Variables.

# Optional, local only (defaults to 3000). Vercel sets its own.
PORT=

# UNICLOTHES shield: "Checking you're human" proof-of-work check before the site.
# The check is OFF until SHIELD_SECRET is set. Use a long random string; mark it Sensitive in Vercel.
SHIELD_SECRET=
# Optional: puzzle difficulty in bits (default 18). Each +1 doubles the work for visitors and bots.
SHIELD_DIFFICULTY=
