# Names only, never real values. Set real values in Vercel → Project → Settings → Environment Variables.

# Optional, local only (defaults to 3000). Vercel sets its own.
PORT=

# Cloudflare Turnstile "are you human" check before the site.
# The check is OFF until both are set. Get them at dash.cloudflare.com → Turnstile → Add widget.
# Mark TURNSTILE_SECRET_KEY as Sensitive in Vercel.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
